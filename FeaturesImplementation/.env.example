# Hotel Management System - Environment Configuration
# Copy this file to .env and configure values as needed

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# API Configuration
API_BASE_URL=http://localhost:3000/api
CORS_ORIGIN=*

# Database Configuration (for future use)
DB_TYPE=sqlite
DB_PATH=./database/hotel.db
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=hotel_management

# Tax Settings
DEFAULT_TAX_RATE=8.5

# Payment Gateway Configuration (for future integration)
PAYMENT_GATEWAY=paypal
PAYMENT_API_KEY=your_api_key_here
PAYMENT_API_SECRET=your_api_secret_here

# Authentication
JWT_SECRET=your_jwt_secret_key_here
SESSION_TIMEOUT=3600

# Email Configuration (for future use)
EMAIL_SERVICE=gmail
EMAIL_USER=noreply@hotel.com
EMAIL_PASSWORD=your_email_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Backup Configuration
BACKUP_INTERVAL=86400000
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/system.log

# Feature Flags
ENABLE_PAYMENT_GATEWAY=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_AUDIT_LOGGING=true
